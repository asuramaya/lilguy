# Copy this to .env (which is gitignored) and fill in real values before
# running `docker compose up`. Compose auto-loads a file literally named
# `.env` in this directory for ${VAR} substitution inside
# docker-compose.yml -- no extra flag needed.
#
# POSTGRES_PASSWORD: required. Generate with, e.g.:
#   python3 -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))"
# ALPHANUMERIC ONLY -- Compose performs variable interpolation on env_file
# values too, and a `$` in the password gets silently mangled into
# something else on the next substitution pass. Confirmed to have bitten
# real deployments; don't relearn it the hard way.
POSTGRES_PASSWORD=

# Optional -- only needed if you activate the commented-out Adzuna/
# USAJobs entries in sources.yaml. See their own comments there for
# where to register for a free key. Leave blank otherwise.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
